package-as: AndoMaps

# Kept in the repo, left out of the addon zip
ignore:
  - README.md
  - Media/AndoMaps-logo.png
  - Media/AndoMaps-emblem.png
  - Media/AndoMaps-emblem.svg
  - Media/AndoMaps-compass.svg
  - Media/AndoMaps-compass-64.png
  - Media/AndoMaps-minimap.svg

# CHANGELOG.md is the release notes on CurseForge and GitHub (instead of a
# list of commit messages). Add a section for each version before tagging it.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
